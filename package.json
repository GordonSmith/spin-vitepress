{
    "name": "spin-vitepress",
    "version": "0.3.1",
    "private": true,
    "scripts": {
        "clean": "rimraf test-c/build test-rust/target test-ts/build test-ts/dist",
        "clean-vcpkg": "rimraf vcpkg/vcpkg vcpkg_installed",
        "clean-all": "run-p clean clean-vcpkg",
        "sync-version": "node scripts/version.mjs sync",
        "version-bump": "node scripts/version.mjs bump patch",
        "version-bump-auto": "node scripts/version.mjs bump-from-history",
        "version-bump-minor": "node scripts/version.mjs bump minor",
        "version-bump-major": "node scripts/version.mjs bump major",
        "prebuild-docs": "npm run sync-version",
        "build-docs": "vitepress build",
        "prebuild-spin": "npm run sync-version",
        "preserve-docs": "npm run sync-version",
        "preserve-spin": "npm run sync-version",
        "serve-docs": "vitepress dev",
        "preview-docs": "vitepress preview",
        "build-spin": "spin build",
        "serve-spin": "spin up",
        "build": "run-s build-spin",
        "serve": "run-p serve-docs serve-spin",
        "update": "npx -y npm-check-updates -u -t minor && cd test-ts && npx -y npm-check-updates -u -t minor",
        "update-major": "npx -y npm-check-updates -u && cd test-ts && npx -y npm-check-updates -u",
        "update-rust": "cd test-rust && cargo update",
        "update-ts": "cd test-ts && npm run update-major && npm install && npm update"
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "npm-run-all": "4.1.5",
        "rimraf": "6.1.3",
        "typescript": "^7.0.2",
        "vitepress": "1.6.4"
    }
}
